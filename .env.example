# FinanceAI — Variables de entorno para docker-compose (raíz del proyecto)
# Copia a .env y ajusta según el entorno. El .env real nunca se commitea (ver .gitignore).

# --- Base de datos (MySQL externo, fuera de Docker Compose) ---
# El backend se conecta por defecto a host.docker.internal, que docker-compose.yml
# resuelve a la IP del host vía "extra_hosts: host-gateway". Esto asume que MySQL
# corre en el mismo servidor que los contenedores, escuchando en un puerto
# alcanzable desde la red de Docker pero NO expuesto públicamente a internet.
# Sobrescribe SPRING_DATASOURCE_URL solo si la base de datos vive en otro host.
# SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/hackathon_finance_ai?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=financeai
SPRING_DATASOURCE_PASSWORD=cambia-esta-contrasena

# --- Seguridad ---
# Mínimo 256 bits / 32 caracteres. Genera un valor propio — nunca uses el default del código.
JWT_SECRET=cambia-este-secreto-por-uno-real-de-32-caracteres-o-mas

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api
